# 主模型：DeepSeek V4.1 Flash（模型 ID 待官方确认后更新）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 降级模型（OpenAI 兼容接口，如 Qwen3）
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=qwen3-32b

# Qwen3Guard（vLLM 部署）；不配置时仅使用启发式审核
GUARD_BASE_URL=
GUARD_API_KEY=
GUARD_MODEL=Qwen/Qwen3Guard-Gen-4B

# 待确认动作 HMAC 密钥（至少 16 位）
CONFIRM_SECRET=
CONFIRM_TTL_SECONDS=300
DATABASE_URL=file:./data/bank.db
PUBLIC_BASE_URL=http://localhost:3000
DEMO_TX_PASSWORD=123456

# 飞书机器人
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BOT_USERNAME=wencai
