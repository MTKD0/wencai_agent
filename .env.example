# 主模型：DeepSeek V4.1 Flash（模型 ID 待官方确认后更新）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 降级模型（OpenAI 兼容接口，如 Qwen3）
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=qwen3-32b

# Qwen3Guard（vLLM 部署）；不配置时仅使用启发式审核
GUARD_BASE_URL=
GUARD_API_KEY=
GUARD_MODEL=Qwen/Qwen3Guard-Gen-4B

# 待确认动作 HMAC 密钥（至少 16 位）；同时用作 better-auth 的签名密钥
CONFIRM_SECRET=
CONFIRM_TTL_SECONDS=300
DATABASE_URL=file:./data/bank.db
# Passkey 的 RP ID / Origin 取自主机名，部署到域名下必须改成真实地址
PUBLIC_BASE_URL=http://localhost:3000
# 未显式设置交易密码的账号使用的默认密码（生产环境请删除此项）
DEMO_TX_PASSWORD=123456

# 演示登录手机号（验证码打印在服务端日志，不接短信网关）
# 13800000000 → 张小明（u_demo）  13800000001 → 李小萌（u_other）

# 飞书机器人
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BOT_USERNAME=wencai

# 管理后台无登录鉴权，仅供本地演示；未设置时，NODE_ENV=production 默认关闭，其他环境默认开启
# ADMIN_ENABLED=false
